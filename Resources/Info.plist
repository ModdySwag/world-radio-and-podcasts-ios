<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Radio &amp; Podcasts</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- The version the app will install on. THIS is what the installer enforces: below it
         the App Store refuses to offer the app and the device refuses to run it, which is
         the install-time half of the compatibility story. It comes from
         IPHONEOS_DEPLOYMENT_TARGET in project.yml and is asserted, in the built app, by
         scripts/verify_bundle.py. Above it, the app still tells the user when their version
         is older than the one it is tuned for - see compat.json. -->
    <key>MinimumOSVersion</key>
    <string>$(IPHONEOS_DEPLOYMENT_TARGET)</string>

    <!-- Background playback: the audio session keeps the stream alive when the app is not
         on screen or the device is locked. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- Launch screen: the app's dark background as an asset colour, so there is no white
         flash before the web app paints (the same thing the Android theme does). -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- Allows iPad Split View / Slide Over: the radio in one pane, something else in the
         other. The shell's player sheet is height-relative and re-measures on resize. -->
    <key>UIRequiresFullScreen</key>
    <false/>

    <!-- ~8,330 of the 47,994 stations are plain http://, and Apple Transport Security
         blocks cleartext by default. This permits it, exactly as the Android app's
         network_security_config does. It weakens nothing else: certificate validation is
         untouched, and https streams are unaffected.
         NSAllowsLocalNetworking is for the bundled page, which is served to the WebView
         from a loopback address by LocalServer.swift. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
